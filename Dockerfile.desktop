# syntax=docker/dockerfile:1.29@sha256:572cebbc2b15e6f84c077742952674889cb63cd5e9b80abdffcbe587b6f19183
# Packages apps/desktop (Electron) for Linux: same Node as Dockerfile.dev,
# plus rpmbuild (.rpm), ar and xz (.deb); AppImage needs nothing extra;
# electron-builder downloads Electron and its tools into its cache).
FROM node:26.13.0-trixie-slim@sha256:5adad64f9a1fca2d51972caa65983634c8a774eb300d72b20f7f2a0f60368072

ENV PNPM_HOME=/pnpm \
    COREPACK_HOME=/pnpm/corepack \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    pnpm_config_store_dir=/app/node_modules/.pnpm-store \
    ELECTRON_BUILDER_CACHE=/cache/electron-builder \
    electron_config_cache=/cache/electron
ENV PATH=/app/node_modules/.bin:$PNPM_HOME:$PATH

RUN npm install -g corepack@0.36.0 && corepack enable

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    rpm \
    binutils \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
CMD ["sh", "-c", "pnpm install --frozen-lockfile --config.confirmModulesPurge=false && pnpm --filter @caesar/desktop dist --linux"]
