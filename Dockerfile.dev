# syntax=docker/dockerfile:1.27@sha256:bde3983e9c939224420ddaf6b784cc30e09b035a4dea01f581230c50809f372e
# Toolchain only: the source is bind-mounted at runtime (compose.dev.yaml),
# node_modules and pnpm's home live in volumes, so the host needs no node.
FROM node:24.20.0-trixie-slim@sha256:50c3b2f6988dfc307b86e5301d69611af31f4789bdf232863b07d3b02fe55ae0

# corepack's pnpm binary cache lives in the /pnpm volume. The package store
# is pinned to the root node_modules volume so hardlinks work. Left to its
# default, pnpm run from a package dir (apps/server, own volume) picks
# /app/.pnpm-store instead: the bind-mounted checkout on the host.
ENV PNPM_HOME=/pnpm \
    COREPACK_HOME=/pnpm/corepack \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    pnpm_config_store_dir=/app/node_modules/.pnpm-store
ENV PATH=$PNPM_HOME:$PATH

RUN corepack enable

# argon2 still needs node-gyp (build-essential, python3). mediasoup's
# postinstall downloads its prebuilt worker, so no python3-pip here.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --chmod=755 scripts/dev-entry.sh /usr/local/bin/dev-entry

WORKDIR /app
EXPOSE 4991 5173 40000
CMD ["dev-entry"]
