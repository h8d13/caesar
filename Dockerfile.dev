# syntax=docker/dockerfile:1.7
FROM node:24-slim

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

# pnpm via corepack (bundled with Node 24).
RUN corepack enable

# argon2 + mediasoup are native; building them needs a toolchain
# (python+pip for mediasoup-worker build, build-essential for argon2 node-gyp).
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential python3 python3-pip ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY . .

RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

EXPOSE 4991 5173 40000

CMD ["sh", "-c", "cd apps/client && pnpm dev --host 0.0.0.0 & cd apps/server && pnpm dev"]
