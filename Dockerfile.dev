# syntax=docker/dockerfile:1.29@sha256:572cebbc2b15e6f84c077742952674889cb63cd5e9b80abdffcbe587b6f19183
# Toolchain only: the source is bind-mounted at runtime (compose.dev.yaml),
# node_modules and pnpm's home live in volumes, so the host needs no node.
FROM node:26.13.0-trixie-slim@sha256:5adad64f9a1fca2d51972caa65983634c8a774eb300d72b20f7f2a0f60368072

# corepack's pnpm binary cache lives in the /pnpm volume. The package store
# is pinned to the root node_modules volume so hardlinks work. Left to its
# default, pnpm run from a package dir (apps/server, own volume) picks
# /app/.pnpm-store instead: the bind-mounted checkout on the host.
ENV PNPM_HOME=/pnpm \
    COREPACK_HOME=/pnpm/corepack \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    pnpm_config_store_dir=/app/node_modules/.pnpm-store
# root workspace bins (vp, vpr, vpx, knip) callable as-is from any package
# dir, instead of through `pnpm exec`
ENV PATH=/app/node_modules/.bin:$PNPM_HOME:$PATH

# Node 25+ no longer bundles corepack; pnpm still comes from packageManager
RUN npm install -g corepack@0.36.0 && corepack enable

# No toolchain: argon2 and libsql ship prebuilt binaries, mediasoup's
# postinstall downloads its prebuilt worker. Nothing runs node-gyp.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --chmod=755 scripts/dev-entry.sh /usr/local/bin/dev-entry

WORKDIR /app
EXPOSE 4991 5173 40000
CMD ["dev-entry"]
