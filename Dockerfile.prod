# syntax=docker/dockerfile:1.7
ARG CAESAR_BUILD_VERSION

FROM node:24-slim AS builder
ARG CAESAR_BUILD_VERSION
ENV CAESAR_BUILD_VERSION=${CAESAR_BUILD_VERSION}
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

RUN corepack enable
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential python3 python3-pip ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .

# pnpm store cache survives layer rebuilds; only invalidated by pnpm-lock.yaml.
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile
RUN pnpm --filter @caesar/client build
RUN pnpm --filter @caesar/server build

# pnpm deploy produces a self-contained dir for just @caesar/server with its
# transitive deps resolved into a flat node_modules. devDeps stripped via
# --prod. Client static output is also copied so the server can serve it.
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm --filter @caesar/server deploy --prod /deploy/server

# --- Runtime stage ---
FROM node:24-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates libnss3-tools && \
    rm -rf /var/lib/apt/lists/*

RUN corepack enable
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

# node:24-slim ships a non-root `node` user at UID 1000. Reuse it instead
# of useradd-ing another at the same UID (which collides and exits 4).
WORKDIR /app
COPY --from=builder --chown=node:node /deploy/server /app
# Client built assets, referenced by the server's interface route.
COPY --from=builder --chown=node:node /app/apps/client/dist /app/interface

USER node
EXPOSE 4991 40000

# tsx runs the TS source directly. If you later compile to JS via tsc, swap
# this to `node ./dist/index.js` (and drop the tsx dep from prod).
CMD ["pnpm", "exec", "tsx", "./src/index.ts"]
