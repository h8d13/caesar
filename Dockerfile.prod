# syntax=docker/dockerfile:1.7
ARG CAESAR_BUILD_VERSION

FROM node:24-slim AS builder
ARG CAESAR_BUILD_VERSION
ENV CAESAR_BUILD_VERSION=${CAESAR_BUILD_VERSION}
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

# MEDIASOUP_WORKER_BIN tells mediasoup-node's postinstall to skip its
# local build (no python+pip / no toolchain). We fetch the kernel6
# prebuilt below and copy it into the runtime data dir at startup.
ENV MEDIASOUP_WORKER_BIN=/usr/local/bin/mediasoup-worker

RUN corepack enable
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .

RUN scripts/fetch-mediasoup-worker.sh /usr/local/bin

RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile
RUN pnpm --filter @caesar/client build
RUN pnpm --filter @caesar/server build

# Self-contained server bundle. devDeps stripped.
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm --filter @caesar/server deploy --prod /deploy/server

# Static assets the server expects to find on disk on first boot.
# loadEmbeds() copies these into DATA_PATH at startup (mirrors the bun
# `embeddedFiles` extraction flow from master).
RUN mkdir -p /staging \
    && cp -r /app/apps/client/dist /staging/interface \
    && cp -r /app/apps/server/src/db/migrations /staging/drizzle \
    && cp /usr/local/bin/mediasoup-worker /staging/mediasoup-worker

# --- Runtime stage ---
FROM node:24-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates libnss3-tools && \
    rm -rf /var/lib/apt/lists/*

ENV CAESAR_ENV=production

# WORKDIR creates /app as root; chown it to node so the runtime user can
# write to it (loadEmbeds copies into DATA_PATH under HOME, but other
# code paths may touch CWD).
WORKDIR /app
RUN chown node:node /app

COPY --from=builder --chown=node:node /deploy/server /app
COPY --from=builder --chown=node:node /staging /app/static-prod-assets

USER node
EXPOSE 4991 40000

# Run tsx via node directly (not via `pnpm exec`): pnpm's verify-deps-on-run
# would otherwise self-heal at container start, downloading pnpm via Corepack
# and writing temp files to /app — EACCES under the non-root user. tsx is a
# runtime dep so `pnpm deploy --prod` keeps it.
CMD ["node", "node_modules/tsx/dist/cli.mjs", "./src/index.ts"]
