# syntax=docker/dockerfile:1.7
ARG CAESAR_BUILD_VERSION

FROM node:24-slim AS builder
ARG CAESAR_BUILD_VERSION
ENV CAESAR_BUILD_VERSION=${CAESAR_BUILD_VERSION}
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

# MEDIASOUP_WORKER_BIN tells mediasoup-node's postinstall to skip the
# build (no python+pip / no toolchain needed). The binary is fetched
# from the pinned GitHub release via scripts/fetch-mediasoup-worker.sh.
ENV MEDIASOUP_WORKER_BIN=/usr/local/bin/mediasoup-worker

RUN corepack enable
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .

# Fetch the kernel6 prebuilt before install so mediasoup's postinstall
# sees MEDIASOUP_WORKER_BIN and short-circuits. Shaves minutes off the
# install layer vs compiling from source.
RUN scripts/fetch-mediasoup-worker.sh /usr/local/bin

# pnpm store cache survives layer rebuilds; only invalidated by pnpm-lock.yaml.
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile
RUN pnpm --filter @caesar/client build
RUN pnpm --filter @caesar/server build

# pnpm deploy produces a self-contained dir for just @caesar/server with its
# transitive deps resolved into a flat node_modules. devDeps stripped via
# --prod. Client static output is also copied so the server can serve it.
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm --filter @caesar/server deploy --prod /deploy/server

# --- Runtime stage ---
FROM node:24-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates libnss3-tools && \
    rm -rf /var/lib/apt/lists/*

RUN corepack enable
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV MEDIASOUP_WORKER_BIN=/usr/local/bin/mediasoup-worker

# node:24-slim ships a non-root `node` user at UID 1000. Reuse it instead
# of useradd-ing another at the same UID (which collides and exits 4).
WORKDIR /app
COPY --from=builder --chown=node:node /deploy/server /app
COPY --from=builder /usr/local/bin/mediasoup-worker /usr/local/bin/mediasoup-worker
# Client built assets, referenced by the server's interface route.
COPY --from=builder --chown=node:node /app/apps/client/dist /app/interface

USER node
EXPOSE 4991 40000

# Run tsx directly via node (not via `pnpm exec`): pnpm's verify-deps-on-run
# would otherwise try to self-heal at container start, downloading pnpm via
# Corepack and writing temp files to /app — which trips EACCES under the
# non-root user. tsx is a runtime dep (kept by pnpm deploy --prod).
CMD ["node", "node_modules/tsx/dist/cli.mjs", "./src/index.ts"]
