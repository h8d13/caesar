# syntax=docker/dockerfile:1.28@sha256:bb22d9815c728170f72750f4e5b0d672e06176142e1d602c7e66c050100b7e5b
ARG CAESAR_BUILD_VERSION

# trixie = Debian 13, same glibc as the cc-debian13 runtime below. mediasoup's
# postinstall self-tests its prebuilt worker here; the kernel7 build (picked
# on kernel 7 hosts) needs glibc >= 2.38 and fails on bookworm.
FROM node:26.13.0-trixie-slim@sha256:5adad64f9a1fca2d51972caa65983634c8a774eb300d72b20f7f2a0f60368072 AS builder
ARG CAESAR_BUILD_VERSION
ENV CAESAR_BUILD_VERSION=${CAESAR_BUILD_VERSION}
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
# Store = the BuildKit cache mount below. Being a separate mount it can't
# hardlink into /app, so pnpm 12 would otherwise fall back to a fresh store in
# node_modules and re-download every build; copying from the cache is cheaper.
ENV pnpm_config_store_dir=/pnpm/store

# Node 25+ no longer bundles corepack; pnpm still comes from packageManager
RUN npm install -g corepack@0.36.0 && corepack enable
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy only manifests first so the (slow) install layer, mediasoup worker
# download included, stays cached across source edits.
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/client/package.json ./apps/client/
COPY apps/server/package.json ./apps/server/
# Full directories, not manifests: injectWorkspacePackages snapshots the
# library packages into node_modules at install; the later `COPY . .`
# never refreshes that copy.
COPY packages/shared ./packages/shared
COPY packages/ui ./packages/ui

RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

# Now the source; edits below this line no longer bust the install.
COPY . .

# non-empty = client sourcemaps + react-dom/profiling, for re-render
# profiling (compose.prod-dev.yaml)
ARG CAESAR_PROFILE
RUN pnpm --filter @caesar/client build
# Bundle (vp pack, Rolldown) + SEA (postject) -> apps/server/dist/caesar.
RUN pnpm --filter @caesar/server build:sea

# Prod node_modules for the externalized deps (argon2 and @libsql/client
# native bindings + mediasoup, whose postinstall downloaded the prebuilt worker for this
# arch/kernel). The SEA binary expects to find these at /app/node_modules at
# runtime (process.cwd() == /app); mediasoup resolves its worker from there.
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm --filter @caesar/server deploy --prod /deploy/server

# distroless has no shell/chown, so stage the whole tree under /out; the runtime
# lays it down with COPY. assets -> /app/static-prod-assets (served and
# migrated in place, see helpers/paths.ts), /home/node/.config/caesar = DATA_PATH.
# DATA_PATH exists in the image so an empty named volume mounted there is
# copied up owned by 1000, on any engine/userns (no host chown needed).
#
# /app is code and stays read-only for the server: root-owned (plain COPY
# below) and a-w on top, /app itself included (staged one level down, under
# /out/code, so the COPY carries its mode instead of creating it 755). A bug
# in the app then cannot rewrite node_modules, the mediasoup worker, the
# served client (sw.js) or the migrations. The SEA imports its bundle from
# /app/.caesar-runtime.mjs through /app/.caesar-runtime-loader.cjs (they
# must sit next to node_modules for bare-specifier resolution) and only
# writes them when they differ from what it embeds (build/bootstrap.cjs):
# shipping the same two build outputs here means it never writes under
# /app.
RUN mkdir -p /out/code/app/static-prod-assets /out/home/node/.config/caesar \
    && cp -r /app/apps/client/dist /out/code/app/static-prod-assets/interface \
    && cp -r /app/apps/server/src/db/migrations /out/code/app/static-prod-assets/drizzle \
    && cp -r /deploy/server/node_modules /out/code/app/node_modules \
    && cp /app/apps/server/dist/server.mjs /out/code/app/.caesar-runtime.mjs \
    && cp /app/apps/server/dist/runtime-loader.cjs /out/code/app/.caesar-runtime-loader.cjs \
    && chmod -R a-w /out/code/app \
    && cp /app/apps/server/dist/caesar /out/caesar \
    && cp -a --parents /usr/lib/*-linux-gnu/libatomic.so.1* /out

# --- Runtime stage ---
# distroless "cc" = glibc + libstdc++ + libgcc: minimum for the Node SEA,
# prebuilt mediasoup-worker and argon2 (all dynamic glibc). "static" has no libc.
# Node 26 also links libatomic, which "cc" lacks: staged from the builder.
FROM gcr.io/distroless/cc-debian13@sha256:159783207c2cd44c2aa5715961d13c8612368ac9bd450f887e3f08fc8ea461e3

# DATA_PATH = XDG_CONFIG_HOME/caesar; set HOME/XDG since uid 1000 has no passwd entry.
ENV CAESAR_ENV=production \
    HOME=/home/node \
    XDG_CONFIG_HOME=/home/node/.config

COPY --from=builder --chmod=755 /out/caesar /usr/local/bin/caesar
COPY --from=builder /out/usr/lib /usr/lib

# /app: root-owned, nothing in it writable by the server (see the staging
# step above). Only DATA_PATH under /home belongs to uid 1000.
COPY --from=builder /out/code/ /
COPY --from=builder --chown=1000:1000 /out/home /home

WORKDIR /app
USER 1000:1000

CMD ["caesar"]
