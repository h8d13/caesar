ARG TARGET=bun-linux-x64
ARG CAESAR_BUILD_VERSION

FROM oven/bun:latest AS builder
ARG TARGET
ARG CAESAR_BUILD_VERSION
ENV CAESAR_BUILD_VERSION=${CAESAR_BUILD_VERSION}

WORKDIR /app
COPY . .
RUN bun install

# Build using the build script
RUN cd apps/server && bun ./build/build.ts --target $TARGET

# --- Runtime stage ---
FROM debian:bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    useradd -u 1000 -m -s /sbin/nologin caesar

COPY --from=builder --chown=caesar:caesar --chmod=755 /app/apps/server/build/out/caesar-* /usr/local/bin/caesar

USER caesar
WORKDIR /home/caesar

EXPOSE 4991 40000

CMD ["caesar"]
