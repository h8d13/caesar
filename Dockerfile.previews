# syntax=docker/dockerfile:1.29@sha256:572cebbc2b15e6f84c077742952674889cb63cd5e9b80abdffcbe587b6f19183
# Records the readme previews (scripts/previews, run by record.sh).
# Same toolchain as Dockerfile.dev, plus Playwright's chromium and ffmpeg.
# Playwright lives in /opt/previews, outside the workspace: no lockfile
# entry, and the library always matches the browser baked in next to it.
FROM node:26.13.1-trixie-slim@sha256:abe7e5a82b61a8ef67b315b85497c9e65173387ccf2f4a029248184b8e020be5

ENV PNPM_HOME=/pnpm \
    COREPACK_HOME=/pnpm/corepack \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    pnpm_config_store_dir=/app/node_modules/.pnpm-store \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ENV PATH=/app/node_modules/.bin:$PNPM_HOME:$PATH

RUN npm install -g corepack@0.36.0 && corepack enable

# fonts-noto-color-emoji: chromium has no emoji font of its own, reactions
# and the emoji picker would render as boxes
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    ffmpeg \
    fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/previews
RUN npm init -y >/dev/null \
    && npm install --save-exact playwright@1.65.1 \
    && npx playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/* /root/.npm

COPY --chmod=755 scripts/previews/entry.sh /usr/local/bin/previews-entry

WORKDIR /app
CMD ["previews-entry"]
