{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,

    "paths": {
      "@/*": ["./src/*"],
      "@server/*": ["../../apps/server/src/*"]
    }
  },
  // ui transitively consumes shared/trpc.ts which references @server/routers;
  // the typecheck then follows into server source which uses these ambient
  // augmentations (ws.WebSocket, fs/promises.exists, globalThis flags).
  "include": ["src", "../../apps/server/src/declarations.d.ts"]
}
