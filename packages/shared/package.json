{
  "name": "@sharkord/shared",
  "version": "0.0.8",
  "type": "module",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./games/crash": "./src/games/crash.ts",
    "./games/roulette": "./src/games/roulette.ts",
    "./games/coinflip": "./src/games/coinflip.ts"
  },
  "scripts": {
    "format": "prettier --write \"**/*.ts*\" --config ./.prettierrc.json",
    "format:check": "prettier --check \"**/*.ts*\" --config ./.prettierrc.json",
    "lint": "eslint ./src/**/*.ts --ext ts --report-unused-disable-directives",
    "lint:fix": "eslint ./src/**/*.ts --ext ts --report-unused-disable-directives --fix",
    "check-types": "tsc --noEmit",
    "magic": "bun --bun run lint:fix && bun --bun run format && bun --bun run check-types",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "@types/react": "^19",
    "typescript": "^5",
    "@types/linkify-it": "^5.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "eslint": "^8.56.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "@trpc/client": "^11.17.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "js-sha256": "^0.11.1",
    "linkify-it": "^5.0.0",
    "mediasoup": "^3.19.22"
  }
}