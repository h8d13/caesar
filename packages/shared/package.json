{
  "name": "@caesar/shared",
  "version": "0.0.8",
  "type": "module",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./db/schema": "./src/db/schema.ts",
    "./games/crash": "./src/games/crash.ts",
    "./games/roulette": "./src/games/roulette.ts",
    "./games/coinflip": "./src/games/coinflip.ts"
  },
  "scripts": {
    "format": "prettier --write \"**/*.ts*\" --config ./.prettierrc.json",
    "format:check": "prettier --check \"**/*.ts*\" --config ./.prettierrc.json",
    "lint": "eslint ./src --report-unused-disable-directives",
    "lint:fix": "eslint ./src --report-unused-disable-directives --fix",
    "check-types": "tsc --noEmit",
    "magic": "pnpm lint:fix && pnpm format && pnpm check-types",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "@types/react": "^19.2.17",
    "typescript": "~6.0.3",
    "@types/linkify-it": "^5.0.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript-eslint": "^8.62.0",
    "@trpc/client": "^11.18.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "js-sha256": "^0.11.1",
    "linkify-it": "^5.0.1",
    "mediasoup": "3.20.0"
  }
}