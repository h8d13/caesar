{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,

    "paths": {
      "@/*": ["./src/*"],
      "@server/*": ["../../apps/server/src/*"]
    }
  },
  // include server's ambient declarations because check-types follows
  // trpc.ts -> AppRouter -> server source (wss.ts uses ws module
  // augmentations, config.ts uses fs/promises.exists, etc).
  "include": ["src", "../../apps/server/src/declarations.d.ts"]
}
