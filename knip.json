{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "apps/server": {
      "entry": ["src/**/__tests__/**/*.test.ts", "build/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/client": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/shared": {
      "entry": ["src/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/ui": {
      "entry": ["src/**/*.ts", "src/**/*.tsx"],
      "project": ["src/**/*.ts", "src/**/*.tsx"]
    }
  },
  "ignore": ["**/*.d.ts"],
  "ignoreBinaries": ["tsc", "prettier", "eslint"],
  "ignoreDependencies": ["tailwindcss", "buffer"],
  "ignoreExportsUsedInFile": true
}
