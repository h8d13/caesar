{
  "name": "caesar",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "mediasoup"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "better-sqlite3",
      "esbuild",
      "mediasoup"
    ]
  },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "format": "pnpm -r --if-present format",
    "format:check": "pnpm -r --if-present format:check",
    "check-types": "pnpm -r --if-present check-types",
    "lint": "pnpm -r --if-present lint",
    "knip": "knip",
    "knip:production": "knip --production",
    "magic": "pnpm format && pnpm check-types && pnpm lint"
  },
  "devDependencies": {
    "knip": "^6.14.1"
  },
  "dependencies": {}
}