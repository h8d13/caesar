{
  "name": "caesar",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24.21.0",
    "pnpm": "^12.9.1"
  },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "format": "pnpm -r --if-present format",
    "format:check": "pnpm -r --if-present format:check",
    "check-types": "pnpm -r --if-present check-types",
    "lint": "pnpm -r --if-present lint",
    "knip": "knip",
    "knip:production": "knip --production",
    "magic": "pnpm format && pnpm check-types && pnpm lint"
  },
  "devDependencies": {
    "knip": "^6.40.0",
    "prettier": "catalog:",
    "prettier-plugin-organize-imports": "catalog:"
  }
}