# Copy to .env next to docker-compose.yaml; compose reads it automatically.
# Everything set here reaches the server (env_file). Unset = default shown.
# Full reference: https://github.com/h8d13/caesar/wiki/Configuration

# --- Deploy ---
# Public host, one name, no port: Caddy cert/site + WebAuthn RP ID.
CAESAR_SITE=localhost
# Image tag: latest (newest release), x.y.z to pin, edge (master).
#CAESAR_IMAGE_TAG=latest

# --- Server ---
#CAESAR_PORT=4991
#CAESAR_DEBUG=false
#CAESAR_MAX_USERS=0
#CAESAR_MAX_REQUEST_BODY_BYTES=65536

# --- WebRTC ---
# Workers bind CAESAR_WEBRTC_PORT + i; the published 40000+ range in
# docker-compose.yaml must cover them.
#CAESAR_WEBRTC_WORKERS=3
#CAESAR_WEBRTC_PORT=40000
#CAESAR_WEBRTC_ANNOUNCED_ADDRESS=
#CAESAR_WEBRTC_MAX_BITRATE=30000000
#CAESAR_WEBRTC_LOG_LEVEL=warn

# --- Auth / proxy ---
#CAESAR_WEBAUTHN_RPNAME=Caesar
#CAESAR_TRUSTED_PROXY_HOPS=1
#CAESAR_TRUSTED_CLIENT_IP_HEADER=
