{
  "name": "@caesar/server",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch ./src/index.ts",
    "dev:inspect": "tsx --inspect ./src/index.ts",
    "dev:debug": "DEBUG=* tsx watch ./src/index.ts",
    "build": "node build/bundle.mjs",
    "build:prod": "NODE_ENV=production node build/bundle.mjs",
    "build:sea": "NODE_ENV=production node build/bundle.mjs && node build/sea.mjs",
    "format": "prettier --write \"**/*.ts*\" --config ./.prettierrc.json",
    "format:check": "prettier --check \"**/*.ts*\" --config ./.prettierrc.json",
    "lint": "eslint ./src --report-unused-disable-directives",
    "lint:fix": "eslint ./src --report-unused-disable-directives --fix",
    "check-types": "tsc --noEmit",
    "magic": "pnpm lint:fix && pnpm format && pnpm check-types",
    "test": "vitest run",
    "test:fast": "SKIP_MEDIASOUP=1 vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/ini": "^4.1.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.13.2",
    "@types/sanitize-html": "^2.16.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@caesar/shared": "workspace:*",
    "@libsql/client": "0.17.4",
    "@simplewebauthn/server": "^13.3.2",
    "@trpc/server": "^11.18.0",
    "argon2": "^0.44.0",
    "cron": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "ini": "^7.0.0",
    "ipaddr.js": "^2.4.0",
    "jsonwebtoken": "^9.0.3",
    "link-preview-js": "^4.0.4",
    "mediasoup": "3.20.10",
    "mime-types": "^3.0.2",
    "queue": "^7.0.0",
    "sanitize-html": "^2.17.5",
    "ua-parser-js": "^2.0.10",
    "uuid": "^14.0.1",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  }
}
