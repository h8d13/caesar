{
  "name": "@caesar/server",
  "version": "0.0.8",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch ./src/index.ts",
    "dev:inspect": "tsx --inspect ./src/index.ts",
    "dev:debug": "DEBUG=* tsx watch ./src/index.ts",
    "build": "node build/bundle.mjs",
    "build:sea": "node build/bundle.mjs && node build/sea.mjs",
    "db:gen": "npx drizzle-kit generate --dialect sqlite --schema ../../packages/shared/src/db/schema.ts --out ./src/db/migrations",
    "db:check": "npx drizzle-kit check --dialect sqlite --out ./src/db/migrations",
    "format": "prettier --write \"**/*.ts*\" --config ./.prettierrc.json",
    "format:check": "prettier --check \"**/*.ts*\" --config ./.prettierrc.json",
    "lint": "eslint ./src --report-unused-disable-directives",
    "lint:fix": "eslint ./src --report-unused-disable-directives --fix",
    "check-types": "tsc --noEmit",
    "magic": "pnpm lint:fix && pnpm format && pnpm check-types",
    "test": "vitest run",
    "test:fast": "SKIP_MEDIASOUP=1 vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.0.0",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.25.0",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "@types/ini": "^4.1.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/sanitize-html": "^2.16.1",
    "@types/ws": "^8.18.1",
    "@eslint/js": "^10.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript-eslint": "^8.59.3"
  },
  "peerDependencies": {
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@caesar/shared": "workspace:*",
    "@trpc/server": "^11.17.0",
    "cron": "^4.4.0",
    "@libsql/client": "0.17.3",
    "argon2": "^0.44.0",
    "drizzle-orm": "^0.45.2",
    "ini": "^7.0.0",
    "ipaddr.js": "^2.4.0",
    "jsonwebtoken": "^9.0.3",
    "link-preview-js": "^4.0.3",
    "mediasoup": "3.19.22",
    "mime-types": "^3.0.2",
    "queue": "^7.0.0",
    "sanitize-html": "^2.17.4",
    "ua-parser-js": "^2.0.9",
    "uuid": "^10.0.0",
    "ws": "^8.20.1",
    "zod": "^4.4.3"
  }
}