{
  "name": "@caesar/server",
  "version": "0.0.8",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch ./src/index.ts",
    "dev:inspect": "bun --inspect ./src/index.ts",
    "dev:debug": "DEBUG=* bun --watch ./src/index.ts",
    "build": "tsc -b && bun ./build/build.ts",
    "db:gen": "bunx drizzle-kit generate --dialect sqlite --schema ./src/db/schema.ts --out ./src/db/migrations",
    "db:check": "bunx drizzle-kit check --dialect sqlite --out ./src/db/migrations",
    "format": "prettier --write \"**/*.ts*\" --config ./.prettierrc.json",
    "format:check": "prettier --check \"**/*.ts*\" --config ./.prettierrc.json",
    "lint": "eslint ./src --report-unused-disable-directives",
    "lint:fix": "eslint ./src --report-unused-disable-directives --fix",
    "check-types": "tsc --noEmit",
    "magic": "bun --bun run lint:fix && bun --bun run format && bun --bun run check-types",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/ini": "^4.1.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/sanitize-html": "^2.16.1",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.1",
    "@eslint/js": "^10.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript-eslint": "^8.59.3"
  },
  "peerDependencies": {
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@caesar/shared": "workspace:*",
    "@trpc/server": "^11.17.0",
    "cron": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "ini": "^7.0.0",
    "ipaddr.js": "^2.4.0",
    "jsonwebtoken": "^9.0.3",
    "link-preview-js": "^4.0.3",
    "mediasoup": "3.19.22",
    "queue": "^7.0.0",
    "sanitize-html": "^2.17.4",
    "ua-parser-js": "^2.0.9",
    "ws": "^8.20.1",
    "yauzl": "^3.3.0",
    "yazl": "^3.3.1",
    "zod": "^4.4.3"
  }
}