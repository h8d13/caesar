{
  "name": "@caesar/server",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch ./src/index.ts",
    "dev:inspect": "tsx --inspect ./src/index.ts",
    "dev:debug": "DEBUG=* tsx watch ./src/index.ts",
    "build": "node build/bundle.mjs",
    "build:prod": "NODE_ENV=production node build/bundle.mjs",
    "build:sea": "NODE_ENV=production node build/bundle.mjs && node build/sea.mjs",
    "format": "prettier --write \"**/*.ts*\" --config ./.prettierrc.json",
    "format:check": "prettier --check \"**/*.ts*\" --config ./.prettierrc.json",
    "lint": "eslint ./src --report-unused-disable-directives",
    "lint:fix": "eslint ./src --report-unused-disable-directives --fix",
    "check-types": "tsc --noEmit",
    "magic": "pnpm lint:fix && pnpm format && pnpm check-types",
    "test": "vitest run",
    "test:fast": "SKIP_MEDIASOUP=1 vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/ini": "^4.1.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mime-types": "^3.0.1",
    "@types/node": "catalog:",
    "@types/sanitize-html": "^2.16.2",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "eslint": "catalog:",
    "eslint-plugin-unused-imports": "catalog:",
    "globals": "catalog:",
    "postject": "^1.0.0-alpha.6",
    "prettier": "catalog:",
    "prettier-plugin-organize-imports": "catalog:",
    "tsx": "^4.23.15",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  },
  "dependencies": {
    "@caesar/shared": "workspace:*",
    "@libsql/client": "0.18.0",
    "@simplewebauthn/server": "^13.3.3",
    "@trpc/server": "catalog:",
    "argon2": "^0.45.0",
    "cron": "^4.4.0",
    "drizzle-orm": "catalog:",
    "ini": "^7.0.0",
    "ipaddr.js": "^2.5.0",
    "jsonwebtoken": "^9.0.3",
    "link-preview-js": "^5.0.0",
    "mediasoup": "catalog:",
    "mime-types": "^3.0.2",
    "queue": "^7.0.0",
    "sanitize-html": "^2.18.0",
    "ua-parser-js": "^2.0.10",
    "uuid": "^14.0.2",
    "web-push": "^3.6.7",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  }
}
