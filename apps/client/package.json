    "@jitsi/rnnoise-wasm": "^0.2.1",
    "@reduxjs/toolkit": "^2.12.0",
    "@sharkord/shared": "workspace:*",
    "@sharkord/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.100.10",
    "@tiptap/core": "^3.23.4",
    "@tiptap/extension-emoji": "^3.23.4",
    "@tiptap/pm": "^3.23.4",
    "@tiptap/react": "^3.23.4",
    "@tiptap/starter-kit": "^3.23.4",
    "@tiptap/suggestion": "^3.23.4",
    "@trpc/client": "^11.17.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "filesize": "^11.0.17",
    "highlight.js": "^11.11.1",
    "html-react-parser": "^6.1.1",
    "lucide-react": "^1.16.0",
    "marked": "^18.0.3",
    "mediasoup-client": "^3.20.0",
    "perfect-freehand": "^1.2.3",
    "prosemirror-view": "^1.41.8",
    "re-reselect": "^5.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-lite-youtube-embed": "^3.5.1",
    "react-redux": "^9.3.0",
    "react-virtuoso": "^4.18.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-react-you-might-not-need-an-effect": "^0.10.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.13",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0"
  }
