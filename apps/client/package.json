{
  "name": "@caesar/client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "test": "vitest run",
    "lint": "eslint ./src --ext ts,tsx",
    "lint:fix": "eslint ./src --ext ts,tsx --report-unused-disable-directives --fix",
    "check-types": "tsc --noEmit --project tsconfig.app.json",
    "format": "prettier --write '**/*.ts*' --config ./.prettierrc.json",
    "format:check": "prettier --check '**/*.ts*' --config ./.prettierrc.json",
    "magic": "pnpm lint:fix && pnpm format && pnpm check-types"
  },
