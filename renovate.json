{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(Europe/Lisbon)"
  ],
  "enabledManagers": ["npm", "github-actions", "dockerfile", "docker-compose", "pre-commit"],
  "rangeStrategy": "bump",
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "schedule": ["before 5am on monday"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on monday"]
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchDepTypes": ["devDependencies"],
      "groupName": "dev minor+patch",
      "automerge": true
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchDepTypes": ["dependencies"],
      "groupName": "prod minor+patch"
    },
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "groupName": "docker"
    },
    {
      "matchManagers": ["pre-commit"],
      "groupName": "pre-commit"
    },
    {
      "matchPackageNames": ["prettier", "prettier-plugin-organize-imports"],
      "groupName": "prettier"
    },
    {
      "matchPackageNames": ["node", "actions/setup-node", "@types/node"],
      "groupName": "node runtime"
    },
    {
      "matchPackageNames": ["typescript", "@types/node", "mediasoup"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "description": "ts/node/mediasoup majors must be approved on the dashboard"
    },
    {
      "matchPackageNames": ["mediasoup"],
      "rangeStrategy": "pin",
      "description": "native worker binary, pin exact"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  }
}
