{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(Europe/Lisbon)",
    "helpers:pinGitHubActionDigests"
  ],
  "pinDigests": true,
  "enabledManagers": [
    "npm",
    "github-actions",
    "dockerfile",
    "docker-compose",
    "pre-commit",
    "custom.regex"
  ],
  "rangeStrategy": "bump",
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "schedule": ["before 5am on monday"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on monday"]
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchDepTypes": ["devDependencies"],
      "groupName": "dev minor+patch",
      "automerge": true
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchDepTypes": ["dependencies"],
      "groupName": "prod minor+patch"
    },
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    { "matchManagers": ["github-actions"], "groupName": "github-actions" },
    { "matchManagers": ["dockerfile", "docker-compose"], "groupName": "docker" },
    { "matchManagers": ["pre-commit"], "groupName": "pre-commit" },
    {
      "matchPackageNames": ["vite-plus", "@voidzero-dev/vite-plus-core"],
      "groupName": "vite-plus",
      "description": "catalog aliases vite to vite-plus-core at the vite-plus version; they ship together"
    },
    {
      "matchPackageNames": ["node", "pnpm", "actions/setup-node", "@types/node"],
      "groupName": "node runtime"
    },
    {
      "matchDepTypes": ["engines"],
      "matchPackageNames": ["node"],
      "rangeStrategy": "widen",
      "description": "engines.node is the minimum the images actually run; bump would raise it to the newest node release, ahead of any docker tag"
    },
    {
      "matchManagers": ["custom.regex"],
      "pinDigests": false,
      "description": "CI node-version is a plain version for setup-node, no digest to pin"
    },
    {
      "matchPackageNames": ["typescript", "@types/node", "mediasoup", "pnpm"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "description": "ts/node/mediasoup/pnpm majors must be approved on the dashboard"
    },
    {
      "matchPackageNames": ["mediasoup", "argon2", "better-sqlite3"],
      "rangeStrategy": "pin",
      "description": "native postinstall, pin exact so prebuilt-binary caches stay valid"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "corepack is npm-installed in the images since Node 25 stopped bundling it",
      "managerFilePatterns": ["/^Dockerfile\\.(dev|prod)$/"],
      "matchStrings": ["npm install -g corepack@(?<currentValue>[0-9.]+)"],
      "depNameTemplate": "corepack",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "setup-node's node-version isn't tracked by the github-actions manager; follow the docker tag so CI moves with the Dockerfiles",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["node-version: '(?<currentValue>[^']+)'"],
      "depNameTemplate": "node",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  }
}
